# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & JWT
# ─────────────────────────────────────────────────────────────────────────────

# Master JWT secret (should be 32+ characters of random data)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-32-chars-min

# Separate secrets for different token types (recommended for security)
# This prevents a leaked access token from being used as a refresh token
JWT_ACCESS_SECRET=access-token-secret-32-chars-minimum-very-secure
JWT_REFRESH_SECRET=refresh-token-secret-32-chars-minimum-very-secure
JWT_TEMP_SECRET=temp-token-secret-32-chars-minimum-very-secure
JWT_RESET_SECRET=reset-token-secret-32-chars-minimum-very-secure

# Token expiration times
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# API KEYS & WEBHOOKS
# ─────────────────────────────────────────────────────────────────────────────

# API key for third-party integrations
API_KEY=sk_live_your_api_key_here_change_in_production

# Webhook signing secret (for verifying webhook requests)
WEBHOOK_SECRET=whsec_your_webhook_secret_change_in_production

# ─────────────────────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for CORS
# In development: http://localhost:3000,http://localhost:3001
# In production: https://app.example.com,https://api.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────────────────
# PRIVACY & DATA RETENTION
# ─────────────────────────────────────────────────────────────────────────────

# User data retention (in days)
# GDPR typically requires you can retrieve data for users who request it
# Default: 2555 days = 7 years
USER_DATA_RETENTION_DAYS=2555

# Audit log retention (in days)
# Compliance often requires 5-10 year retention for audit logs
# Default: 3650 days = 10 years
AUDIT_LOG_RETENTION_DAYS=3650

# Activity log retention (in days)
# Default: 365 days = 1 year
ACTIVITY_LOG_RETENTION_DAYS=365

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY HEADERS
# ─────────────────────────────────────────────────────────────────────────────

# Strict Transport Security (HSTS) - forces HTTPS
# Max age in seconds; includeSubDomains; preload for inclusion in browsers' HSTS lists
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Content Security Policy
CSP_DIRECTIVE=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# X-Frame-Options (clickjacking prevention)
X_FRAME_OPTIONS=DENY

# X-Content-Type-Options (MIME type sniffing prevention)
X_CONTENT_TYPE_OPTIONS=nosniff

# Referrer-Policy
REFERRER_POLICY=strict-origin-when-cross-origin

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────

# Global rate limit (requests per minute)
RATE_LIMIT_GLOBAL_MAX=10000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# Auth endpoints rate limit
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000

# API endpoints rate limit
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW_MS=60000

# Oracle endpoints (stricter)
RATE_LIMIT_ORACLE_MAX=10
RATE_LIMIT_ORACLE_WINDOW_MS=60000

# Admin endpoints rate limit
RATE_LIMIT_ADMIN_MAX=20
RATE_LIMIT_ADMIN_WINDOW_MS=60000

# Withdrawal/financial transactions (very strict)
RATE_LIMIT_WITHDRAWAL_MAX=5
RATE_LIMIT_WITHDRAWAL_WINDOW_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# PASSWORD SECURITY
# ─────────────────────────────────────────────────────────────────────────────

# Bcrypt rounds (higher = more secure but slower; 10-12 recommended)
BCRYPT_ROUNDS=12

# Password complexity requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Password history (don't allow last N passwords)
PASSWORD_HISTORY_COUNT=5

# Account lockout after N failed attempts
ACCOUNT_LOCKOUT_ATTEMPTS=5

# Account lockout duration (in minutes)
ACCOUNT_LOCKOUT_DURATION=15

# ─────────────────────────────────────────────────────────────────────────────
# TWO-FACTOR AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────

# Require 2FA for admin accounts
REQUIRE_2FA_ADMIN=true

# Optional 2FA for regular users
REQUIRE_2FA_USERS=false

# TOTP window (30 seconds is standard)
TOTP_WINDOW=30

# ─────────────────────────────────────────────────────────────────────────────
# INPUT VALIDATION
# ─────────────────────────────────────────────────────────────────────────────

# Maximum JSON payload size (in bytes)
MAX_JSON_PAYLOAD_SIZE=10485760

# Maximum text field size (in bytes)
MAX_TEXT_FIELD_SIZE=10000

# Maximum array length
MAX_ARRAY_LENGTH=1000

# Maximum object nesting depth
MAX_OBJECT_DEPTH=20

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ─────────────────────────────────────────────────────────────────────────────

# Log level (error, warn, info, debug, trace)
LOG_LEVEL=info

# Enable request logging
REQUEST_LOGGING_ENABLED=true

# Enable audit logging
AUDIT_LOGGING_ENABLED=true

# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─────────────────────────────────────────────────────────────────────────────
# ENCRYPTION
# ─────────────────────────────────────────────────────────────────────────────

# Encryption key for sensitive data at rest (should be 32 bytes / 64 hex chars)
ENCRYPTION_KEY=your-encryption-key-64-hex-characters-minimum-32-bytes

# Encryption algorithm
ENCRYPTION_ALGORITHM=aes-256-gcm

# ─────────────────────────────────────────────────────────────────────────────
# API DOCUMENTATION
# ─────────────────────────────────────────────────────────────────────────────

# Enable Swagger/OpenAPI documentation
ENABLE_SWAGGER=true

# Swagger endpoint (default: /api/docs)
SWAGGER_PATH=/api/docs
